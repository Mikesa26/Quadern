<!doctype html>
<html lang="ca">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Notes, exàmens i deures de batxillerat en un sol lloc.">
<style>html{color-scheme:light}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Quadern de Batxillerat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Layout: quadrille-paper page, sticky bar with highlighter tabs, sheets (white cards) on a single column that opens into a grid on wide screens. */
:root{
  --paper:#F1F5F4; --sheet:#FFFFFF; --ink:#13202A; --ink2:#51606B; --line:#D3DCDA; --grid:rgba(19,32,42,.05);
  --pen:#1A4FD3; --pen-ink:#FFFFFF; --pen-soft:#E3EBFD;
  --hi:#FFE55A; --hi-soft:#FFF4B0;
  --red:#C92A2A; --red-soft:#FBE4E2; --green:#18794E; --green-soft:#DDF3E8;
  --sl:.58; --sc:.14;
  --f-display:'Familjen Grotesk','Helvetica Neue',Arial,sans-serif;
  --f-body:'Instrument Sans','Helvetica Neue',Arial,sans-serif;
  --f-mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --paper:#0E161C; --sheet:#16212A; --ink:#E7EEF2; --ink2:#9AA9B4; --line:#2A3945; --grid:rgba(231,238,242,.045);
  --pen:#86A8FF; --pen-ink:#0A1220; --pen-soft:#1D2B4A;
  --hi:#6B5D12; --hi-soft:#3B3410;
  --red:#FF8078; --red-soft:#3E1D1C; --green:#58CBA0; --green-soft:#153A2C;
  --sl:.76; --sc:.12; color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#0E161C; --sheet:#16212A; --ink:#E7EEF2; --ink2:#9AA9B4; --line:#2A3945; --grid:rgba(231,238,242,.045);
  --pen:#86A8FF; --pen-ink:#0A1220; --pen-soft:#1D2B4A;
  --hi:#6B5D12; --hi-soft:#3B3410;
  --red:#FF8078; --red-soft:#3E1D1C; --green:#58CBA0; --green-soft:#153A2C;
  --sl:.76; --sc:.12; color-scheme:dark}

*{box-sizing:border-box}
body{font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);background-color:var(--paper);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px}
h1,h2,h3,h4{font-family:var(--f-display);text-wrap:balance;margin:0;line-height:1.15;font-weight:600}
h1{font-size:28px}h2{font-size:21px}h3{font-size:16px}h4{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink2);font-weight:600}
p{margin:0}
a{color:var(--pen)}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--pen);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding-inline:16px;padding-block-end:56px}
.muted{color:var(--ink2)}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}

.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--paper);border-bottom:1px solid var(--line);margin-inline:-16px;padding-inline:16px}
.bar-in{max-width:1080px;margin:0 auto}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-block:12px 4px}
.brand{display:flex;align-items:center;gap:10px}
.brand-mark{width:18px;height:22px;border:2px solid var(--ink);border-radius:2px 5px 5px 2px;border-left-width:5px;display:inline-block}
.brand-name{font-family:var(--f-display);font-weight:700;font-size:20px;letter-spacing:-.01em}
.sync{font-size:12.5px;color:var(--ink2)}
.nav{display:flex;gap:2px;overflow-x:auto;padding-block:6px 8px;scrollbar-width:none}
.nav::-webkit-scrollbar{display:none}
.tab{white-space:nowrap;background:none;border:0;padding:5px 10px;font-weight:600;color:var(--ink2);cursor:pointer;border-radius:3px}
.tab[aria-current="page"]{color:var(--ink);background:linear-gradient(transparent 56%,var(--hi) 56%)}

.chip{display:inline-flex;align-items:center;font-family:var(--f-mono);font-size:12px;padding:1px 8px;border:1px solid var(--line);border-radius:99px;color:var(--ink2);white-space:nowrap;background:var(--sheet)}
.chip.hot{color:var(--ink);background:var(--hi-soft);border-color:var(--hi)}
.chip.late{color:var(--red);background:var(--red-soft);border-color:var(--red)}
.tagc{font-size:13px;color:oklch(var(--sl) var(--sc) var(--h,250));font-weight:500}
.dotc{display:inline-block;width:12px;height:12px;border-radius:50%;background:oklch(var(--sl) var(--sc) var(--h,250));flex:none}

.sheet{background:var(--sheet);border:1px solid var(--line);border-radius:8px;padding:16px}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,310px),1fr));align-items:start}
.stack{display:flex;flex-direction:column;gap:16px}
.sec-head{display:flex;flex-direction:column;gap:4px;padding-block:20px 14px}
.head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap}
.empty{color:var(--ink2);padding:14px;border:1px dashed var(--line);border-radius:8px;background:transparent}

.btn{background:var(--pen);color:var(--pen-ink);border:1px solid var(--pen);border-radius:6px;padding:8px 14px;font-weight:600;cursor:pointer}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn.danger{background:transparent;color:var(--red);border-color:var(--red)}
.btn.sm{padding:4px 10px;font-size:13px}
.in{background:var(--sheet);border:1px solid var(--line);border-radius:6px;padding:8px 10px;width:100%;min-width:0}
textarea.in{resize:vertical;min-height:84px;line-height:1.45}
.frow{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.frow>*{flex:1 1 140px;min-width:0}
.frow>.btn{flex:0 0 auto}
.lbl{font-size:12px;color:var(--ink2);display:flex;flex-direction:column;gap:3px}
.form{display:flex;flex-direction:column;gap:10px}
.note{font-size:13px;color:var(--ink2)}
.ok{color:var(--green)}.bad{color:var(--red)}

.fchip{background:var(--sheet);border:1px solid var(--line);border-radius:99px;padding:3px 12px;font-size:13px;cursor:pointer}
.fchip[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-block:14px}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.segb{background:var(--sheet);border:0;padding:8px 14px;cursor:pointer;font-weight:600}
.segb+.segb{border-left:1px solid var(--line)}
.segb[aria-pressed="true"]{background:var(--ink);color:var(--paper)}

.tasks{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.task{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--line)}
.task:first-child{border-top:0}
.task-main{flex:1;min-width:0;display:flex;flex-direction:column}
.task-title{overflow-wrap:anywhere}
.task.done .task-title{text-decoration:line-through;color:var(--ink2)}
.task-meta{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.prio{font-size:11.5px;font-weight:600;padding:0 6px;border-radius:3px;background:var(--hi-soft)}
.prio.p2{background:var(--red-soft);color:var(--red)}
.check{width:22px;height:22px;border-radius:5px;border:2px solid var(--ink2);background:var(--sheet);cursor:pointer;display:grid;place-items:center;font-size:14px;line-height:1;flex:none;padding:0;color:var(--pen-ink)}
.check[aria-pressed="true"]{background:var(--green);border-color:var(--green)}
.x{background:none;border:0;color:var(--ink2);font-size:20px;line-height:1;cursor:pointer;padding:2px 6px;border-radius:4px}
.x:hover{color:var(--red)}
.bucket{display:flex;flex-direction:column;gap:2px;margin-top:14px}

.subj{text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:10px;width:100%}
.subj:hover{border-color:var(--ink2)}
.subj-top{display:flex;align-items:center;gap:8px}
.subj-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap}
.big{font-size:26px;font-weight:500}
.avg-line{display:flex;align-items:center;gap:10px;padding-block:5px}
.avg-line .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-track{height:6px;border-radius:3px;background:var(--line);width:90px;overflow:hidden;flex:none}
.bar-track i{display:block;height:100%;background:oklch(var(--sl) var(--sc) var(--h,250))}

.stabs{display:flex;gap:6px;flex-wrap:wrap;margin-block:14px}
.back{background:none;border:0;color:var(--pen);cursor:pointer;padding:0;font-weight:600}

.ghead,.grow{display:grid;grid-template-columns:minmax(0,1fr) 84px 84px 30px;gap:8px;align-items:center}
.ghead{font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink2);padding-bottom:6px}
.grow{padding-block:5px}
.grow .in.sc{text-align:right;font-family:var(--f-mono)}
.grow .in.low{color:var(--red);border-color:var(--red)}
.sim{background:var(--hi-soft);border:1px solid var(--hi);border-radius:8px;padding:14px;margin-top:6px}

.exam{border:1px solid var(--line);border-radius:8px;background:var(--sheet);overflow:hidden}
.exam-head{width:100%;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;text-align:left;background:none;border:0;padding:14px 16px;cursor:pointer;align-items:center}
.exam-title{font-family:var(--f-display);font-weight:600;font-size:16px;overflow-wrap:anywhere}
.exam-date{font-size:13px;color:var(--ink2)}
.meter{grid-column:1 / -1;height:6px;background:var(--line);border-radius:3px;overflow:hidden;display:block}
.meter i{display:block;height:100%;background:var(--green)}
.exam-body{padding:4px 16px 16px;display:flex;flex-direction:column;gap:18px;border-top:1px solid var(--line)}
.topic{display:flex;align-items:center;gap:10px;padding:6px 0;border-top:1px solid var(--line)}
.topic:first-child{border-top:0}
.topic span.tt{flex:1;min-width:0;overflow-wrap:anywhere}
.st{border:1px solid var(--line);background:var(--sheet);border-radius:99px;padding:2px 10px;font-size:12px;cursor:pointer;white-space:nowrap;min-width:88px;text-align:center}
.st.s1{background:var(--hi-soft);border-color:var(--hi)}
.st.s2{background:var(--green-soft);border-color:var(--green);color:var(--green)}
.flash{border:1px solid var(--line);border-radius:8px;padding:28px 18px;min-height:150px;display:grid;place-items:center;text-align:center;cursor:pointer;background:var(--sheet);font-size:18px;font-family:var(--f-display);overflow-wrap:anywhere;width:100%}
.flash.back-side{background:var(--pen-soft);border-color:var(--pen)}

.mat-list{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));align-items:start}
.mat{display:flex;flex-direction:column;gap:8px}
.mat-top{display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}
.mat-body{white-space:pre-wrap;overflow-wrap:anywhere;max-height:220px;overflow:auto;font-size:14px}
.mat-foot{display:flex;justify-content:space-between;gap:8px;align-items:center;font-size:12.5px;color:var(--ink2);flex-wrap:wrap}

.checks{display:grid;gap:4px 16px;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))}
.checks label{display:flex;gap:8px;align-items:flex-start;padding:4px 0;cursor:pointer}
.checks input{margin-top:5px}
.hello{padding-block:24px 6px;display:flex;flex-direction:column;gap:4px}
.task-desc{font-size:13.5px;color:var(--ink2);white-space:pre-wrap;overflow-wrap:anywhere}
details.more{border:1px dashed var(--line);border-radius:6px;padding:6px 10px}
details.more>summary{cursor:pointer;color:var(--pen);font-weight:600;font-size:13.5px}
.acts{display:flex;gap:6px;flex-wrap:wrap}
.cat-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.cat-head h3{flex:1 1 auto;min-width:0;overflow-wrap:anywhere}
.sc{text-align:right;font-family:var(--f-mono)}
.srow{display:grid;grid-template-columns:minmax(0,1fr) 84px 30px;gap:8px;align-items:center;padding-block:5px}
.srow.conf{display:flex;flex-wrap:wrap}
.ghead.scheme-g{grid-template-columns:minmax(0,1fr) 84px 30px}
.stat-lines{display:flex;flex-direction:column;gap:6px;margin-top:12px}
.stat-lines>div{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.tiles{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));margin-bottom:16px}
.tile{display:flex;flex-direction:column;gap:2px}
.tscroll{overflow-x:auto}
.trow{display:grid;grid-template-columns:minmax(170px,1.4fr) 64px 72px 64px minmax(150px,1.2fr);gap:10px;align-items:center;padding:9px 4px;border:0;border-top:1px solid var(--line);min-width:600px;width:100%;text-align:left;background:none;font:inherit;color:inherit;cursor:pointer}
.trow:hover:not(.head){background:var(--pen-soft)}
.trow.head{cursor:default;color:var(--ink2);font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;border-top:0}
.ai-sec{border:1px solid var(--line);border-radius:8px;padding:14px;background:var(--sheet)}
.ai-sec.ess{background:var(--hi-soft);border-color:var(--hi)}
.ai-sec.pal{background:transparent;border-style:dashed}
.ai-sec ul,.ai-q ul{margin:6px 0 0;padding-left:20px}
.ai-block+.ai-block{margin-top:12px}
.ai-q{border-top:1px solid var(--line);padding-top:12px}
.ai-q ul.opts{list-style:none;padding-left:4px}
@media (prefers-reduced-motion:no-preference){.btn,.tab,.fchip{transition:background-color .12s,color .12s}}
</style>

</head>
<body>
<div id="app"><div class="wrap"><p class="muted" style="padding-block:40px">Obrint el quadern...</p></div></div>

<script>
(function(){
'use strict';

/* ---------- Catàleg d'assignatures ---------- */
var G={com:'Comunes',cie:'Ciències i Tecnologia',hum:'Humanitats i Ciències Socials',art:'Arts',opt:'Optatives i idiomes'};
var CAT=[],CATMAP={};
function add1(id,name,course,g){var o={id:id,name:name,course:course,g:g};CAT.push(o);CATMAP[id]=o;}
function both(id,name,g,roman){var r=roman!==false;add1(id+'1',name+(r?' I':''),1,g);add1(id+'2',name+(r?' II':''),2,g);}
both('cat','Llengua catalana i literatura','com');
both('cas','Llengua castellana i literatura','com');
both('ang','Llengua estrangera (anglès)','com');
add1('fil1','Filosofia',1,'com');
add1('hfil2','Història de la filosofia',2,'com');
add1('his2','Història',2,'com');
add1('ef1','Educació física',1,'com');
both('tut','Tutoria','com',false);
add1('tr2','Treball de recerca',2,'com');
both('mat','Matemàtiques','cie');
both('fis','Física','cie');
both('qui','Química','cie');
both('bio','Biologia','cie');
add1('geo1','Geologia i ciències ambientals',1,'cie');
both('dtc','Dibuix tècnic','cie');
both('tec','Tecnologia i enginyeria','cie');
add1('elec2','Electrotècnia',2,'cie');
both('mas','Matemàtiques aplicades a les ciències socials','hum');
both('llat','Llatí','hum');
both('grec','Grec','hum');
add1('eco1','Economia',1,'hum');
add1('emp2','Economia de l\'empresa i disseny de models de negoci',2,'hum');
add1('hmc1','Història del món contemporani',1,'hum');
add1('lu1','Literatura universal',1,'hum');
add1('geog2','Geografia',2,'hum');
add1('hart2','Història de l\'art',2,'hum');
both('dart','Dibuix artístic','art');
both('cav','Cultura audiovisual','art');
both('aesc','Arts escèniques','art');
both('anm','Anàlisi musical','art');
both('dis','Disseny','art');
both('tic','Tecnologies de la informació i la comunicació','opt');
both('fra','Segona llengua estrangera (francès)','opt');
both('ale','Segona llengua estrangera (alemany)','opt');
add1('psi2','Psicologia',2,'opt');

var KINDS={apunts:'Apunts',resum:'Resum',exercicis:'Exercicis',examen:'Examen d\'altres anys',enllac:'Enllaç'};

/* ---------- Utilitats ---------- */
function h(tag,attrs){
  var el=document.createElement(tag),val;
  if(attrs){for(var k in attrs){var v=attrs[k];if(v==null||v===false)continue;
    if(k==='class')el.className=v;
    else if(k.slice(0,2)==='on')el.addEventListener(k.slice(2),v);
    else if(k==='value')val=v;
    else if(k==='checked'||k==='selected'||k==='disabled'||k==='required')el[k]=true;
    else el.setAttribute(k,v===true?'':String(v));}}
  for(var i=2;i<arguments.length;i++)put(el,arguments[i]);
  if(val!==undefined)el.value=val;
  return el;
}
function put(el,c){if(c==null||c===false)return;if(Array.isArray(c)){c.forEach(function(x){put(el,x);});}else el.append(c.nodeType?c:String(c));}
function pad(n){return String(n).padStart(2,'0');}
function iso(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());}
function today(){return iso(new Date());}
function parseD(s){var p=s.split('-').map(Number);return new Date(p[0],p[1]-1,p[2]);}
function daysTo(s){return Math.round((parseD(s)-parseD(today()))/864e5);}
function fmtD(s){return parseD(s).toLocaleDateString('ca-ES',{weekday:'short',day:'numeric',month:'short'});}
function plusDays(n){var d=new Date();d.setDate(d.getDate()+n);return iso(d);}
function rel(s){var d=daysTo(s);if(d===0)return 'avui';if(d===1)return 'demà';if(d===-1)return 'ahir';return d>0?'en '+d+' dies':'fa '+(-d)+' dies';}
function uid8(){return Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-4);}
function num(v){var n=parseFloat(String(v).replace(',','.'));return isNaN(n)?null:n;}
function fmtN(n){return n==null?'':n.toLocaleString('ca-ES',{maximumFractionDigits:2,minimumFractionDigits:0});}
function hue(id){var x=0;for(var i=0;i<id.length;i++)x=(x*31+id.charCodeAt(i))%360;return (x*7)%360;}
function safeUrl(u){return /^https?:\/\//i.test(u||'');}

/* ---------- Estat ---------- */
function defaults(){return {v:2,course:null,subjects:[],custom:[],grades:[],tasks:[],exams:[],notes:{},schemes:{}};}
var state=defaults();
var ui={tab:'avui',subj:null,stab:'notes',exam:null,practice:null,matFilter:'all',showDone:false,sim:{},confirm:null,ai:null,aiMsg:'',aiNode:null,iaExam:'',iaOpt:null};
var STATIC=true;
var C=window.claude,userCap=null,dbCap=null,sampleCap=null,me=null,myId=null,canWrite=null;
var docRef=null,mode='local',syncState='local',syncNode=null,saveTimer=null,saving=false,dirty=false,needsUpload=false;
var material=[],matErr=null,matHost=null,booted=false;

function lsKey(){return 'quadern.v1.'+(myId||'anon');}
function lsGet(){try{var s=localStorage.getItem(lsKey());return s?JSON.parse(s):null;}catch(e){return null;}}
function lsSet(){try{localStorage.setItem(lsKey(),JSON.stringify(state));}catch(e){}}
function migrate(d){
  d.grades.forEach(function(g){
    if(g.cat===undefined){
      var w=typeof g.weight==='number'&&g.weight>0?g.weight:0;
      var cid='k'+uid8();
      (d.schemes[g.subj]=d.schemes[g.subj]||[]).push({id:cid,name:g.name||'Prova',weight:w});
      g.cat=cid;g.w=1;
    }
    delete g.weight;
    if(typeof g.w!=='number'||!(g.w>0))g.w=1;
    if(!g.at)g.at=Date.now();
  });
  return d;
}
function merged(o){var d=defaults();for(var k in d){if(o&&o[k]!=null)d[k]=o[k];}return migrate(d);}

var SYNC={cloud:'Desat al teu compte',local:'Només en aquest dispositiu',saving:'Desant...',err:'No s\'ha pogut desar',full:'Compte ple, no es pot desar'};
function setSync(s){syncState=s;if(syncNode)syncNode.textContent=SYNC[s]||'';}
function persist(){
  lsSet();
  if(mode!=='cloud'||!docRef)return;
  dirty=true;setSync('saving');
  clearTimeout(saveTimer);saveTimer=setTimeout(flush,700);
}
function flush(){
  if(!docRef||mode!=='cloud')return;
  if(saving){saveTimer=setTimeout(flush,400);return;}
  dirty=false;saving=true;
  docRef.set(JSON.parse(JSON.stringify(state))).then(function(){saving=false;if(dirty)flush();else setSync('cloud');})
  .catch(function(e){saving=false;var c=e&&e.code;
    if(c==='invalid_argument'){mode='local';setSync('local');}
    else if(c==='quota_exceeded'||c==='resource_exhausted'){setSync('full');}
    else{setSync('err');}});
}

/* ---------- Dades derivades ---------- */
function subjInfo(id){return CATMAP[id]||state.custom.filter(function(c){return c.id===id;})[0]||null;}
function subjName(id,fb){var s=subjInfo(id);return s?s.name:(fb||'Assignatura');}
function mySubjects(){
  return state.subjects.map(function(id){return subjInfo(id);}).filter(function(s){return s&&s.course===state.course;});
}
function mySet(){var o={};mySubjects().forEach(function(s){o[s.id]=1;});return o;}
function catStats(subj){
  return (state.schemes[subj]||[]).map(function(c){
    var items=state.grades.filter(function(g){return g.subj===subj&&g.cat===c.id;});
    var gr=items.filter(function(g){return g.score!=null;});
    var W=gr.reduce(function(a,g){return a+g.w;},0);
    var a=W?gr.reduce(function(t,g){return t+g.score*g.w;},0)/W:null;
    return {cat:c,items:items,avg:a};
  });
}
function stats(subj){
  var cs=catStats(subj),tot=0,ev=0,pts=0,rem=0;
  cs.forEach(function(s){var w=s.cat.weight>0?s.cat.weight:0;tot+=w;if(s.avg!=null){ev+=w;pts+=s.avg*w;}else rem+=w;});
  return {cats:cs,total:tot,evaluated:ev,remaining:rem,points:pts,avg:ev?pts/ev:null,acc:tot?pts/tot:null,max:tot?(pts+10*rem)/tot:null};
}
function avg(id){return stats(id).avg;}
function progress(ex){
  if(!ex.topics.length)return 0;
  return ex.topics.reduce(function(a,t){return a+t.status/2;},0)/ex.topics.length;
}
function needsSetup(){return !state.course||!mySubjects().length;}
function byDue(a,b){var x=a.due||'9999',y=b.due||'9999';return x<y?-1:x>y?1:(b.prio||0)-(a.prio||0);}
function buckets(tasks){
  var b={late:[],today:[],week:[],later:[],done:[]};
  tasks.forEach(function(t){
    if(t.done){b.done.push(t);return;}
    var d=t.due?daysTo(t.due):999;
    if(d<0)b.late.push(t);else if(d===0)b.today.push(t);else if(d<=7)b.week.push(t);else b.later.push(t);
  });
  for(var k in b)b[k].sort(byDue);
  return b;
}

