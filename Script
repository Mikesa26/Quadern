function round1(n){return Math.round(n*10)/10;}
function toPass(st){
  if(!st.total)return 'Defineix la ponderació';
  if(!st.remaining)return st.avg>=5?'Aprovada':'Per sota de 5';
  var n=(5*st.total-st.points)/st.remaining;
  if(n<=0)return 'Ja tens el 5';
  if(n>10)return 'No arribes al 5';
  return 'Cal un '+fmtN(Math.ceil(n*100)/100)+' a la resta';
}
