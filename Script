function aiLsSet(id){try{localStorage.setItem(aiLsKey(id),JSON.stringify(aiCache[id]));}catch(e){}}
function aiLoad(id){
  if(aiCache[id])return Promise.resolve(aiCache[id]);
  var local=aiLsGet(id);
  if(mode==='cloud'&&dbCap&&myId){
    return dbCap.doc('data/users/'+myId+'/ai_'+id).get().then(function(s){
      aiCache[id]=s.exists?aiNorm(JSON.parse(JSON.stringify(s.data()))):(local||aiDefault());return aiCache[id];
    }).catch(function(){aiCache[id]=local||aiDefault();return aiCache[id];});
  }
  aiCache[id]=local||aiDefault();return Promise.resolve(aiCache[id]);
}
function aiPersist(id){
  aiLsSet(id);
  if(mode!=='cloud'||!dbCap||!myId)return;
  clearTimeout(aiTimers[id]);
  aiTimers[id]=setTimeout(function push(){
    if(aiSaving[id]){aiTimers[id]=setTimeout(push,500);return;}
    aiSaving[id]=true;
    dbCap.doc('data/users/'+myId+'/ai_'+id).set(JSON.parse(JSON.stringify(aiCache[id])))
      .then(function(){aiSaving[id]=false;}).catch(function(){aiSaving[id]=false;});
  },900);
}
function str(x,n){return typeof x==='string'?x.slice(0,n||600):'';}
function arr(x){return Array.isArray(x)?x:[];}
function cleanSummary(d){
  d=d||{};
  function blocks(a){return arr(a).slice(0,30).map(function(b){b=b||{};return {tema:str(b.tema,160),punts:arr(b.punts).slice(0,12).map(function(p){return str(p,400);}).filter(Boolean)};}).filter(function(b){return b.tema||b.punts.length;});}
  return {essencial:blocks(d.essencial),important:blocks(d.important),
    palla:arr(d.palla).slice(0,30).map(function(b){b=b||{};return {tema:str(b.tema,200),motiu:str(b.motiu,300)};}).filter(function(b){return b.tema;}),
    falta:arr(d.falta).slice(0,10).map(function(x){return str(x,300);}).filter(Boolean),avis:str(d.avis,500)};
}
function cleanTest(d){
  d=d||{};
  return {titol:str(d.titol,160)||'Examen de prova',durada:Number(d.durada_min)>0?Math.round(Number(d.durada_min)):0,
    preguntes:arr(d.preguntes).slice(0,20).map(function(q){q=q||{};return {tipus:str(q.tipus,30),enunciat:str(q.enunciat,1500),punts:Number(q.punts)>0?Number(q.punts):1,opcions:arr(q.opcions).slice(0,6).map(function(o){return str(o,300);}),solucio:str(q.solucio,2000),criteri:str(q.criteri,600)};}).filter(function(q){return q.enunciat;})};
}
function aiHeader(id,ctx,ex){
  var exTxt=ex?ex.title+(ex.topics.length?'. Temes de l\'examen: '+ex.topics.map(function(t){return t.t;}).join('; '):''):'tot el temari proporcionat';
  return `Assignatura: ${subjName(id)} (${state.course===1?'1r':'2n'} de batxillerat)
Com són els exàmens del professor, segons l'alumne: ${ctx.style.trim()||'(no ho ha explicat)'}
Examen que prepara: ${exTxt}

Temari i apunts de l'alumne (és l'única font que pots fer servir):
"""
${ctx.material.trim()}
"""`;
}
function promptSummary(id,ctx,ex){
  return `Ets un tutor de batxillerat que ajuda un alumne a preparar un examen. Escriu en català.

${aiHeader(id,ctx,ex)}

Tasca: fes un resum de la matèria separant el gra de la palla.
- "essencial": el que l'alumne ha de saber sí o sí, tenint en compte l'estil d'examen descrit. Agrupa per temes i dona punts curts i concrets (definicions, fórmules, dates, passos).
- "important": el que convé saber però no és el nucli.
- "palla": coses dels apunts que, vist l'estil d'examen i el pes que tenen, és poc probable que el professor demani (anècdotes, exemples il·lustratius, dades secundàries, repeticions, ampliacions). Per a cadascuna, el motiu en una frase. Si l'alumne no ha explicat com són els exàmens, sigues prudent i posa a la palla només el que és clarament accessori.
- "falta": coses que l'examen probablement demanarà però que els apunts no cobreixen (pot quedar buit).
- "avis": una frase que recordi que la classificació és una estimació.
No inventis contingut que no sigui als apunts.

Respon només amb un objecte JSON d'aquesta forma:
{"essencial":[{"tema":"","punts":[""]}],"important":[{"tema":"","punts":[""]}],"palla":[{"tema":"","motiu":""}],"falta":[""],"avis":""}`;
}
var KIND_TXT={mixt:'el tipus que sembli més propi d\'aquest professor segons la descripció (si no es pot saber, barreja test, preguntes curtes i alguna de desenvolupament)',test:'preguntes tipus test de 4 opcions',curt:'preguntes curtes',des:'preguntes de desenvolupament',prob:'problemes o exercicis pràctics'};
function promptTest(id,ctx,ex,opt){
  var only=ex&&ex.topics.length?' i, dins d\'ells, en els temes de l\'examen':'';
  return `Ets un professor de batxillerat que prepara un examen de prova per a un alumne. Escriu en català.

${aiHeader(id,ctx,ex)}

Tasca: crea un examen de prova de ${opt.nq} preguntes, del tipus següent: ${KIND_TXT[opt.kind]||KIND_TXT.mixt}.
- Basa'l només en els apunts${only}.
- Imita l'estil, el format i la dificultat que descriu l'alumne.
- Reparteix els punts perquè sumin 10.
- Dona la solució completa de cada pregunta i, a "criteri", com es puntuaria.
- Les de test porten 4 opcions a "opcions" ("a) ...", "b) ...") i la solució indica la lletra correcta i el perquè. Les altres no porten "opcions".

Respon només amb un objecte JSON d'aquesta forma:
{"titol":"","durada_min":0,"preguntes":[{"tipus":"test|curta|desenvolupament|problema","enunciat":"","punts":0,"opcions":[],"solucio":"","criteri":""}]}`;
}
function aiErr(e){
  var c=e&&e.code;
  if(c==='not_granted')return 'Has de permetre que la pàgina faci servir Claude amb el teu compte.';
  if(c==='rate_limited')return 'Has arribat al límit d\'ús. Torna-ho a provar d\'aquí una estona.';
  if(c==='invalid_json')return 'La resposta no ha sortit en el format esperat. Torna-ho a provar.';
  if(c==='prompt_too_large')return 'Hi ha massa text. Redueix el temari.';
  if(c==='sampling_disabled')return 'Claude no està disponible per al teu compte o la teva organització.';
  if(c==='session_expired')return 'Torna a iniciar sessió i prova-ho de nou.';
  if(c==='refused')return 'No s\'ha pogut generar amb aquest contingut. Canvia el text i prova-ho de nou.';
  return 'No s\'ha pogut generar. Torna-ho a provar.';
}
function runAI(id,kind){
  if(ui.ai||!sampleCap)return;
  aiLoad(id).then(function(ctx){
    if(ctx.material.trim().length<200){ui.aiMsg='Enganxa primer el temari o els apunts. Ara n\'hi ha massa poc.';render();return;}
    var ex=state.exams.filter(function(e){return e.id===ui.iaExam;})[0]||null;
    var opt=ui.iaOpt||{nq:'10',kind:'mixt'};
    var prompt=kind==='summary'?promptSummary(id,ctx,ex):promptTest(id,ctx,ex,opt);
    var ctl=new AbortController();
    ui.ai={id:id,kind:kind,ctl:ctl};ui.aiMsg='';render();
    sampleCap.json(prompt,{signal:ctl.signal,cache:false,onText:function(u){if(ui.aiNode)ui.aiNode.textContent='Escrivint... '+u.text.length+' caràcters';}})
    .then(function(data){
      if(kind==='summary'){ctx.summary={at:Date.now(),exam:ex?ex.title:'',d:cleanSummary(data)};}
      else{ctx.tests.unshift({at:Date.now(),exam:ex?ex.title:'',d:cleanTest(data)});ctx.tests=ctx.tests.slice(0,2);}
      aiPersist(id);ui.ai=null;ui.aiMsg='';render();
    }).catch(function(e){ui.ai=null;ui.aiMsg=(e&&e.code==='cancelled')?'Aturat.':aiErr(e);render();});
  });
}
function when(t){return new Date(t).toLocaleString('ca-ES',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'});}
function summaryView(s){
  var d=s.d;
  function sec(title,cls,list){
    if(!list.length)return null;
    return h('div',{class:'ai-sec '+cls},h('h3',{style:'margin-bottom:8px'},title),list.map(function(b){return h('div',{class:'ai-block'},h('b',{},b.tema),h('ul',{},b.punts.map(function(p){return h('li',{},p);})));}));
  }
  return h('div',{class:'stack',style:'gap:12px'},
    h('p',{class:'note'},'Generat el '+when(s.at)+(s.exam?' per a "'+s.exam+'"':'')),
    sec('Imprescindible','ess',d.essencial),
    sec('Important','imp',d.important),
    d.palla.length?h('div',{class:'ai-sec pal'},h('h3',{},'Palla probable'),
      h('p',{class:'note',style:'margin:4px 0'},'Segons com són els exàmens d\'aquest professor, és poc probable que ho demani. Mira-ho abans de descartar-ho.'),
      h('ul',{},d.palla.map(function(b){return h('li',{},h('b',{},b.tema),b.motiu?' · '+b.motiu:'');}))):null,
    d.falta.length?h('div',{class:'ai-sec'},h('h3',{},'Què no cobreixen els teus apunts'),h('ul',{},d.falta.map(function(f){return h('li',{},f);}))):null,
    d.avis?h('p',{class:'note'},d.avis):null);
}
function testView(t){
  var d=t.d,total=d.preguntes.reduce(function(a,q){return a+q.punts;},0);
  return h('div',{class:'stack',style:'gap:12px'},
    h('div',{class:'head-row'},h('h3',{},d.titol),h('span',{class:'chip'},fmtN(round1(total))+' punts'+(d.durada?' · '+d.durada+' min':''))),
    h('p',{class:'note'},'Generat el '+when(t.at)+(t.exam?' per a "'+t.exam+'"':'')),
    d.preguntes.map(function(q,i){
      return h('div',{class:'ai-q'},
        h('p',{},h('b',{},(i+1)+'. '),q.enunciat,' ',h('span',{class:'note'},'('+fmtN(q.punts)+' pt)')),
        q.opcions.length?h('ul',{class:'opts'},q.opcions.map(function(o){return h('li',{},o);})):null,
        h('details',{class:'more',style:'margin-top:8px'},h('summary',{},'Veure la solució'),
          h('p',{style:'margin-top:6px;white-space:pre-wrap'},q.solucio||'Sense solució.'),
          q.criteri?h('p',{class:'note',style:'white-space:pre-wrap;margin-top:4px'},'Com es puntua: '+q.criteri):null));
    }));
}
function panelIA(id){
  var host=h('div',{},h('p',{class:'muted'},'Carregant...'));
  aiLoad(id).then(function(ctx){host.replaceChildren(buildIA(id,ctx));});
  return host;
}
function buildIA(id,ctx){
  var exams=state.exams.filter(function(e){return e.subj===id;}).sort(function(a,b){return a.date<b.date?-1:1;});
  if(ui.iaExam&&!exams.some(function(e){return e.id===ui.iaExam;}))ui.iaExam='';
  var opt=ui.iaOpt||(ui.iaOpt={nq:'10',kind:'mixt'});
  var busy=ui.ai&&ui.ai.id===id?ui.ai:null;
  var canAI=!!sampleCap;
  var cnt=h('span',{class:'note'});
  function updCnt(){cnt.textContent=ctx.material.length.toLocaleString('ca-ES')+' de '+AI_MAX.toLocaleString('ca-ES')+' caràcters';}
  var style=h('textarea',{id:'ia-style',class:'in',style:'min-height:120px',maxlength:2000,'aria-label':'Com són els exàmens del professor',
    placeholder:'P. ex.: 10 preguntes, la meitat test i la resta de desenvolupar. Posa molts problemes, gairebé no demana dates. Les definicions han de ser literals. Dura 1 hora.',
    oninput:function(e){ctx.style=e.target.value;aiPersist(id);}});
  style.value=ctx.style;
  var mat=h('textarea',{id:'ia-mat',class:'in',style:'min-height:240px',maxlength:AI_MAX,'aria-label':'Temari i apunts',
    placeholder:'Enganxa aquí el temari, els apunts o el resum que us ha donat el professor.',
    oninput:function(e){ctx.material=e.target.value;aiPersist(id);updCnt();}});
  mat.value=ctx.material;updCnt();
  var mats=material.filter(function(m){return m.subj===id&&m.body;});
  var mSel=h('select',{id:'ia-msel',class:'in','aria-label':'Material de la classe'},
    h('option',{value:''},mats.length?'Afegir material de la classe...':'Encara no hi ha material de la classe'),
    mats.map(function(m){return h('option',{value:m.id},m.title);}));
  var addBtn=h('button',{type:'button',class:'btn ghost',onclick:function(){
    var m=mats.filter(function(x){return x.id===mSel.value;})[0];if(!m)return;
    ctx.material=(ctx.material+'### '+m.title+'\n'+m.body+'\n\n').slice(0,AI_MAX);mat.value=ctx.material;aiPersist(id);updCnt();mSel.value='';}},'Afegir');
  var exSel=h('select',{id:'ia-exam',class:'in','aria-label':'Examen que prepares',value:ui.iaExam||'',onchange:function(e){ui.iaExam=e.target.value;}},
    h('option',{value:''},'Tot el temari'),
    exams.map(function(e){return h('option',{value:e.id},e.title+' ('+fmtD(e.date)+')');}));
  var nq=h('select',{id:'ia-nq',class:'in','aria-label':'Nombre de preguntes',value:opt.nq,onchange:function(e){opt.nq=e.target.value;}},
    ['6','10','15'].map(function(n){return h('option',{value:n},n+' preguntes');}));
  var kd=h('select',{id:'ia-kind',class:'in','aria-label':'Tipus de preguntes',value:opt.kind,onchange:function(e){opt.kind=e.target.value;}},
    h('option',{value:'mixt'},'Com el professor'),h('option',{value:'test'},'Test'),h('option',{value:'curt'},'Preguntes curtes'),h('option',{value:'des'},'Desenvolupament'),h('option',{value:'prob'},'Problemes'));
  var statusNode=h('p',{class:'note'+(!busy&&ui.aiMsg?' bad':''),role:'status'},busy?'Pensant... pot trigar fins a un minut.':(ui.aiMsg||''));
  ui.aiNode=busy?statusNode:null;
  var actions=h('div',{class:'sheet form'},
    h('h2',{},'Què vols fer?'),
    canAI?null:h('p',{class:'empty'},'L\'assistent d\'IA no està disponible en aquesta vista. Obre la pàgina des de claude.ai amb el teu compte.'),
    h('label',{class:'lbl'},'Per a quin examen',exSel),
    h('div',{class:'frow'},h('button',{type:'button',class:'btn',disabled:!canAI||!!ui.ai,onclick:function(){runAI(id,'summary');}},'Resum sense palla')),
    h('div',{style:'border-top:1px solid var(--line);padding-top:12px',class:'form'},
      h('div',{class:'frow'},nq,kd),
      h('div',{class:'frow'},h('button',{type:'button',class:'btn',disabled:!canAI||!!ui.ai,onclick:function(){runAI(id,'test');}},'Generar examen de prova'))),
    busy?h('div',{class:'frow'},statusNode,h('button',{type:'button',class:'btn danger sm',onclick:function(){busy.ctl.abort();}},'Atura')):statusNode,
    h('p',{class:'note'},'Cada generació gasta l\'ús del compte de Claude de qui la fa. La primera vegada et demanarà permís.'));
  var results=[];
  if(ctx.summary)results.push(h('div',{class:'sheet'},h('h2',{style:'margin-bottom:10px'},'Resum del temari'),summaryView(ctx.summary)));
  ctx.tests.forEach(function(t){results.push(h('div',{class:'sheet'},testView(t)));});
  return h('div',{class:'grid'},
    h('div',{class:'stack'},
      h('div',{class:'sheet form'},h('h2',{},'Com és el teu professor'),
        h('p',{class:'note'},'Explica com són els seus exàmens: tipus de preguntes, què pesa més, què no demana mai, durada. Com més concret, millor encerta la palla.'),style),
      h('div',{class:'sheet form'},h('h2',{},'Temari i apunts'),mat,cnt,
        h('div',{class:'frow'},mSel,addBtn))),
    h('div',{class:'stack'},actions,results));
}

/* ---------- Estructura general ---------- */
var TABS=[['avui','Avui'],['assignatures','Assignatures'],['notes','Notes'],['deures','Deures'],['material','Material de la classe'],['config','Configuració']];
function render(){
  matHost=null;
  if(!booted)return;
  var setup=needsSetup();
  if(setup)ui.tab='config';
  var view=ui.tab==='avui'?viewAvui():ui.tab==='assignatures'?viewAssignatures():ui.tab==='notes'?viewNotes():ui.tab==='deures'?viewDeures():ui.tab==='material'?viewMaterial():viewConfig();
  syncNode=h('span',{class:'sync',role:'status'},SYNC[syncState]||'');
  var root=h('div',{class:'wrap'},
    h('div',{class:'bar'},h('div',{class:'bar-in'},
      h('div',{class:'top'},h('div',{class:'brand'},h('span',{class:'brand-mark','aria-hidden':'true'}),h('span',{class:'brand-name'},'Quadern'),state.course?h('span',{class:'chip'},state.course===1?'1r batxillerat':'2n batxillerat'):null),syncNode),
      h('nav',{class:'nav','aria-label':'Seccions'},TABS.filter(function(t){return t[0]!=='material';}).map(function(t){
        return h('button',{type:'button',class:'tab','aria-current':ui.tab===t[0]?'page':null,disabled:setup&&t[0]!=='config',onclick:function(){ui.tab=t[0];ui.subj=null;ui.practice=null;render();window.scrollTo(0,0);}},t[1]);})))),
    view);
  document.getElementById('app').replaceChildren(root);
}

/* ---------- Arrencada ---------- */
function use(n){try{return C&&C.use?Promise.resolve(C.use(n)).catch(function(){return null;}):Promise.resolve(null);}catch(e){return Promise.resolve(null);}}
function boot(){
  Promise.all([use('user'),use('db'),use('sample')]).then(function(r){
    userCap=r[0];dbCap=r[1];sampleCap=r[2];
    return userCap?Promise.all([userCap.me(),userCap.can('data.write'),userCap.canEdit()]):[null,null,false];
  }).then(function(r){
    me=r[0];myId=me&&me.id?me.id:null;canWrite=r[1];ui.isEditor=!!r[2];
    var local=lsGet();
    if(dbCap&&myId){
      docRef=dbCap.doc('data/users/'+myId+'/main');
      return docRef.get().then(function(s){
        if(s.exists){state=merged(JSON.parse(JSON.stringify(s.data())));}
        else if(local){state=merged(local);needsUpload=true;}
        mode='cloud';setSync('cloud');
      }).catch(function(){if(local)state=merged(local);mode='local';setSync('local');});
    }
    if(local)state=merged(local);
    mode='local';setSync('local');
  }).then(function(){
    if(needsUpload){flush();}
    booted=true;ui.tab=needsSetup()?'config':'avui';render();
    if(dbCap){
      try{
        dbCap.collection('material').orderBy('at','desc').limit(400).onSnapshot(function(s){
          matErr=null;material=s.docs.map(function(d){var o=Object.assign({},d.data());o.id=d.id;return o;});
          if(matHost&&document.body.contains(matHost))fillMat();
        },function(e){matErr=e&&e.code||'err';if(matHost&&document.body.contains(matHost))fillMat();});
      }catch(e){matErr='err';}
    }
  });
}
boot();
})();
</script>

